[Unit]
Description=Nuxt 3 Nitro SSR Server for <%= fetch(:application) %>_<%= fetch(:stage) %>
After=network.target

[Service]
Type=simple
User=<%= fetch(:nuxt3_ssr_user) %>
Group=<%= fetch(:nuxt3_ssr_user) %>

WorkingDirectory=<%= shared_path %>/<%= fetch(:nuxt3_output_folder) %>

# Nitro listens on host:port; the nginx proxy passes through to it.
# NOTE (Port-Disziplin, shared box): nuxt3_ssr_port MUST be unique per SSR
# instance on a shared host — two units on the same port → EADDRINUSE, the
# second won't start. Default 3500; allocate a free port per app/stage and
# point nginx_upstream_port at it. (Contract §4.4)
#
# NOTE (Bind-Host, cross-host proxy — Contract §4.5/G16):
#   nuxt3_ssr_host = 127.0.0.1 (default) → Single-Host: Proxy + App same box. SAFE.
#   nuxt3_ssr_host = 0.0.0.0              → Cross-Host: proxy is on ANOTHER box
#     (recipes2go/proxy_nginx pattern) → Nitro must bind all interfaces so the
#     remote proxy can reach it. Unlike recipes2go puma/thin (App-Nginx fronts a
#     unix socket), there is NO App-Nginx in front of Nitro here.
#   ⚠️ SECURITY (when host = 0.0.0.0): the bare Nitro process then listens on all
#      interfaces. The requirement is only that this port be reachable ONLY by the
#      proxy. HOW that isolation is done is OPERATOR/infra (T4) — NOT the gem:
#        • tailnet-only (Austin/moja): traffic runs over Tailscale, NO public ports
#          exist → 0.0.0.0 is already safe; access control = Tailscale ACLs. No
#          firewall action needed.
#        • only if NOT tailnet-only (box has a public interface): the deployer
#          isolates the port themselves (firewall/VPN). recipes2go `ufw` is unfit
#          (bare allows only, no `from <ip>`, `ufw --force reset`).
#      recipes4nuxt ships no ufw recipe; do NOT use `ufw_additional_ports` or a
#      per-deploy ufw task here. See Contract §4.5 / G16.
Environment=NODE_ENV=production
Environment=NITRO_HOST=<%= fetch(:nuxt3_ssr_host) %>
Environment=NITRO_PORT=<%= fetch(:nuxt3_ssr_port) %>
Environment=HOST=<%= fetch(:nuxt3_ssr_host) %>
Environment=PORT=<%= fetch(:nuxt3_ssr_port) %>
<%= fetch(:nuxt3_ssr_env, {}).map { |k, v| "Environment=#{k}=#{v}" }.join("\n") %>

# Per-instance runtime ENV (NUXT_PUBLIC_*, server-only secrets) — uploaded by
# `nuxt3:ssr:upload_env` from the consuming app's config/nuxt_env/<stage>.env.
# Leading '-' = optional: a missing file is NOT an error (zero-config-safe).
# Loaded AFTER the static Environment= lines above, so file values win. (Contract §4.2)
EnvironmentFile=-<%= shared_path %>/config/<%= fetch(:nuxt3_ssr_env_file) %>

# nvm-activated node, same bash -lc pattern as the build tasks.
ExecStart=/bin/bash -lc '<%= nuxt3_nvm_prefix %> && exec node <%= shared_path %>/<%= fetch(:nuxt3_output_folder) %>/server/index.mjs'

# PID-File explicit for Monit/supervision (mirrors puma_service)
PIDFile=<%= fetch(:nuxt3_pid_path) %>/<%= fetch(:nuxt3_ssr_service_file) %>.pid
ExecStartPost=/bin/bash -c 'echo $MAINPID > <%= fetch(:nuxt3_pid_path) %>/<%= fetch(:nuxt3_ssr_service_file) %>.pid'
ExecStopPost=/bin/bash -c 'rm -f <%= fetch(:nuxt3_pid_path) %>/<%= fetch(:nuxt3_ssr_service_file) %>.pid'

Restart=always
RestartSec=5
StartLimitBurst=3
StartLimitInterval=30

StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=nuxt3_ssr_<%= fetch(:application) %>_<%= fetch(:stage) %>

[Install]
WantedBy=multi-user.target
